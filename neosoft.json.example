  "_catatan_identitas": "Satu pernyataan SELECT dengan satu tanda ? untuk No. RM. Beri alias kolom ke nama berikut: rm, nama, nik, tgl_lahir, kelamin, wa, alamat, kota, email (yang tidak ada boleh dilewati). Nama tabel/kolom sebenarnya didapat dari: node neosoft-explore.js > neosoft-skema.txt",
  "identitas": {
    "sql": "SELECT no_rm AS rm, nama_pasien AS nama, nik, tgl_lahir, jenis_kelamin AS kelamin, no_hp AS wa, alamat, kota FROM pasien WHERE no_rm = ? LIMIT 1"
  },
